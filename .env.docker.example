# ---------------------------------------------------------------------------
# NetPulse deployment config. Copy to .env and edit BEFORE first run:
#   cp .env.docker.example .env
# docker compose reads this .env automatically for ${VAR} substitution.
# ---------------------------------------------------------------------------

# --- MongoDB (runs internally; not exposed to the network) ---
MONGO_ROOT_USER=netpulse
MONGO_ROOT_PASSWORD=change-this-to-a-strong-password
DB_NAME=netpulse

# --- Application ---
# false  = monitor your REAL network (recommended for production)
# true   = built-in simulated demo network (for evaluation only)
DEMO_MODE=false

# Host port the web UI is served on -> http://<server-ip>:HTTP_PORT
HTTP_PORT=80

# Same-origin UI, so "*" is fine on a trusted LAN.
CORS_ORIGINS=*

# Container timezone (affects log/alert timestamps), e.g. America/New_York
TZ=UTC
